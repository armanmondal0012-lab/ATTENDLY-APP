rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid == "7AOEs1d8hGQGYxU2GAyKCjdhkTG3";
    }

    // Public app configuration only: no student names, IDs, phone numbers or attendance.
    match /attendly/public {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.data is map;
      allow delete: if false;
    }

    // Full admin backup and private records remain admin-only.
    match /attendly/shared {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.data is map;
      allow delete: if false;
    }

    // A student can read only the profile document whose ID equals their Auth UID.
    // Only the authorized admin can create, edit or delete student profiles.
    match /studentProfiles/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Student attendance is private to that student and the authorized admin.
    match /studentAttendance/{userId}/records/{recordId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Each device can manage only its own FCM token records.
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Only the authenticated Attendly admin can queue or view notifications.
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.sent == false;
      allow update, delete: if isAdmin();
    }
  }
}
